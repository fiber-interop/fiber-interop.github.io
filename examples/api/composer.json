        { "type": "path", "url": "../../../scope" },
        { "type": "path", "url": "../../../phasync" },
        { "type": "path", "url": "../../../revolt" },
        { "type": "path", "url": "../../../amp" },
        { "type": "path", "url": "../../../react" }
    ]
